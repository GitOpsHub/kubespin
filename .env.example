# Cloud auth is CLI-based, not env vars: run `aws sso login` / `az login` /
# `gcloud auth application-default login` first — kubespin picks those
# sessions up automatically per --provider. Nothing cloud-credential-shaped
# belongs in this file.

# Required for `kubespin apply`/`delete` (non-dry-run): GitHub token with
# repo-create/push scope in GITHUB_ORG. Used for the cluster's own repo,
# regardless of which cloud it runs on.
GITHUB_TOKEN=

# Org cluster repositories are created in. kubespin does not read this
# directly — --github-org is a plain cobra flag, not env-bound — so export
# this and pass it yourself: kubespin apply --github-org "$GITHUB_ORG" ...
GITHUB_ORG=GitOpsHub

# Required for apply/delete/fleet commands: no default, so it must come from
# here, --registry-region, or the config file.
KUBESPIN_REGISTRY_REGION=us-east-1

# Optional: only if not using the default table name (kubespin-fleet-registry).
# KUBESPIN_REGISTRY_TABLE=

# Optional: CLI logging.
# KUBESPIN_LOG_LEVEL=info
# KUBESPIN_LOG_FORMAT=text
